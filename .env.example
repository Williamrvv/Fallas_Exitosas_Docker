# Fallas Exitosas · Configuración del entorno
# Autor : William Valverde V.
# Fecha : 2026-09-24
# NUNCA versionar este archivo. Ver .env.example para la plantilla.

PROJECT_NAME=anc_fallas_exitosas
APP_ENV=desarrollo
APP_BIND_ADDRESS=0.0.0.0
WEB_PORT=8320
WEB_PORT_SSL=44320
APP_PUBLIC_ORIGIN=https://localhost:44320

# Sesión: 30 min de inactividad, 8 h de tope absoluto.
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

# --- Base de datos propia (motor SQL Server del entorno de William) ---
# El proyecto NO instala ni levanta un motor: se conecta al que ya existe.
#   · Motor en otro equipo de la red:  DB_HOST=192.168.0.3
#   · Motor en ESTA laptop:            DB_HOST=host.docker.internal
#   · Instancia nombrada (Express):    DB_HOST=192.168.0.3\SQLEXPRESS
#     (con instancia nombrada DB_PORT se ignora; resuelve el SQL Browser y
#      hace falta el servicio SQL Server Browser activo)
DB_HOST=
DB_PORT=1433
DB_NAME=anc_fallas_exitosas
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_CERT=yes

# --- Microsoft Entra ID ---
# El tenant es el mismo de la organización y se reutiliza.
# CLIENT_ID y CLIENT_SECRET corresponden al App Registration NUEVO de
# Fallas Exitosas: hay que crearlo y completarlos antes del primer ingreso.
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_REDIRECT_URI=https://localhost:44320/callback.php

# --- TLS ---
TLS_DEVELOPMENT_CA_ENABLED=true
TLS_CERTIFICATE_COMMON_NAME=localhost
TLS_CERTIFICATE_SAN=DNS:localhost,IP:127.0.0.1,IP:192.168.0.12

# --- Espejo TSD (solo lectura; se usará en fases posteriores) ---
TSD_DB_HOST=
TSD_DB_NAME=DWH_ANC
TSD_DB_USER=
TSD_DB_PASSWORD=

# --- Correo saliente (alertas; se usará en fases posteriores) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
